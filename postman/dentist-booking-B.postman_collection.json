        {
          "name": "Get dentists + pick slots",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// random future 15-minute slot, 1-30 days ahead, so re-runs and other data do not collide",
                  "const SLOT_MS = 15 * 60 * 1000, DAY = 24 * 60 * 60 * 1000;",
                  "const base = Math.ceil((Date.now() + DAY + Math.floor(Math.random() * 29 * DAY)) / SLOT_MS) * SLOT_MS;",
                  "pm.collectionVariables.set(\"SLOT\", new Date(base).toISOString());",
                  "pm.collectionVariables.set(\"SLOT2\", new Date(base + SLOT_MS).toISOString());",
                  "pm.collectionVariables.set(\"SLOT3\", new Date(base + 2 * SLOT_MS).toISOString());",
                  "pm.collectionVariables.set(\"SLOT_OFF_GRID\", new Date(base + 7 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const dentists = pm.response.json().data;",
                  "pm.test(\"at least 2 dentists (run npm run seed)\", () => pm.expect(dentists.length).to.be.at.least(2));",
                  "pm.collectionVariables.set(\"DENTIST_ID\", dentists[0]._id);",
                  "pm.collectionVariables.set(\"DENTIST2_ID\", dentists[1]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{URL}}/api/v1/dentists"
          }
        },
        {
          "name": "Cleanup old bookings of user1/user2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "// leftovers from an earlier failed run would break the one-booking tests",
                  "const owners = [pm.collectionVariables.get(\"USER1_ID\"), pm.collectionVariables.get(\"USER2_ID\")];",
                  "pm.response.json().data.filter((b) => owners.includes(b.user)).forEach((b) => {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.get(\"URL\") + \"/api/v1/bookings/\" + b._id,",
                  "        method: \"DELETE\",",
                  "        header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"TOKEN_ADMIN\") }",
                  "    }, (err, res) => pm.test(\"removed old booking \" + b._id, () => pm.expect(res.code).to.eql(200)));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{URL}}/api/v1/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN_ADMIN}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
