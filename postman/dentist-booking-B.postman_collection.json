        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"response has a token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "if (pm.response.code !== 200) {",
                  "    // every later test needs this token; stop so the real cause is the first failure",
                  "    console.error(\"Setup login failed (\" + pm.response.code + \"). Run `npm run seed` and check the server URL.\");",
                  "    pm.execution.setNextRequest(null);",
                  "} else {",
                  "    pm.collectionVariables.set(\"TOKEN_ADMIN\", pm.response.json().token);",
                  "    pm.collectionVariables.set(\"ADMIN_ID\", pm.response.json()._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
