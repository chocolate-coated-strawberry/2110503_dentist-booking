@startuml Manage Auth
autoactivate on

header Dentist Booking Sequence Diagram
title "Manage Auth (Register, Login, Logout)"

participant "Client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

== Register ==
client -> server : req.post('/api/v1/auth/register')
server -> routerAuth : app.use('/api/v1/auth', auth)
routerAuth -> controllersAuth : register()
controllersAuth -> modelUser : create({name, tel, email, password})
note right of modelUser
  role is never read from the body
  tel: spaces and dashes removed, 9-10 digits starting with 0
  pre('save'): bcrypt hash of the password
end note
modelUser -> UsersDatabase : insert user (hashed password)
return user
return user
controllersAuth -> modelUser : getSignedJwtToken()
return token
return response (201) with token and cookie
return
return
note over client, controllersAuth
  Errors: 400 duplicate email (E11000),
  400 missing tel / invalid tel / password shorter than 6 / invalid email
end note

== Login ==
client -> server : req.post('/api/v1/auth/login')
server -> routerAuth : app.use('/api/v1/auth', auth)
routerAuth -> controllersAuth : login()
controllersAuth -> modelUser : findOne({email}).select('+password')
modelUser -> UsersDatabase : find by email
return user (or null)
return user (or null)
controllersAuth -> modelUser : matchPassword(password)
return bcrypt.compare result
controllersAuth -> modelUser : getSignedJwtToken()
return token
return response (200) with token and cookie
return
return
note over client, controllersAuth
  Errors: 400 email or password missing or not a string,
  401 unknown email or wrong password (same message)
end note

== Logout ==
client -> server : req.get('/api/v1/auth/logout')
server -> routerAuth : app.use('/api/v1/auth', auth)
routerAuth -> middlewareAuth : protect()
middlewareAuth -> modelUser : findById(decoded.id)
return user
return
routerAuth -> controllersAuth : logout()
return response (200), cookie token set to "none"
return
return
note over client, middlewareAuth
  Error: 401 no token, invalid token, or user no longer exists
end note

@enduml
